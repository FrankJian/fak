{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fak",
  "identifier": "com.fak.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "log",
          "json",
          "yaml",
          "yml",
          "toml",
          "xml",
          "ini",
          "conf"
        ],
        "name": "Fak.Document",
        "description": "Fak document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FrankJian/fak/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQ0RGMEUxQUQzQzdFN0UKUldSK2ZqeXQ0ZkROSzEwZ2t5eGlXbElRNVV3SEszeHZrb2xCemZ5UWFTZWEyN3k2N1RTek1uOUYK"
    }
  }
}
